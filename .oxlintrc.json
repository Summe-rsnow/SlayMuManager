{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": "off",
    "typescript/no-explicit-any": "off",
    "unicorn/prefer-string-replace-all": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "src-tauri/**",
    "node_modules/**"
  ]
}
